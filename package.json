{
  "name": "ticketrail",
  "version": "0.1.0",
  "description": "A ticket rail for your coding agent: a kanban board that lives in your project and that Claude Code works from. JSON files on disk are the bridge between the UI and the agent.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Marc Porst",
  "homepage": "https://github.com/marc-porst/ticketrail#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marc-porst/ticketrail.git"
  },
  "bugs": {
    "url": "https://github.com/marc-porst/ticketrail/issues"
  },
  "bin": {
    "ticketrail": "dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "templates",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build:cli && npm run build:web",
    "build:cli": "tsup",
    "build:web": "vite build web",
    "dev:web": "vite web",
    "dev:server": "tsx watch src/cli/index.ts serve",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "chokidar": "^4.0.3"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tailwindcss/vite": "^4.1.13",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^29.1.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.1.13",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "claude",
    "claude-code",
    "kanban",
    "agent",
    "task-board"
  ]
}
